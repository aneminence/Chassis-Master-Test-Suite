<Window x:Class="Chassis_Master_Test_Suite.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chassis Master Test Suite"
        Width="1000"
        Height="563"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="SplashProgressBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FFFFC968" Offset="0"/>
            <GradientStop Color="#FFFFE6A6" Offset="0.72"/>
            <GradientStop Color="#FFFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SplashProgressStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource SplashProgressBrush}"/>
            <Setter Property="Background" Value="#19000000"/>
            <Setter Property="BorderBrush" Value="#A9BDC4CC"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <Grid Margin="1">
                                <Border x:Name="PART_Track" CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FFFFC35B"
                                                          BlurRadius="11"
                                                          ShadowDepth="0"
                                                          Opacity="0.9"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF02060C" SnapsToDevicePixels="True">
        <Viewbox Stretch="Uniform">
            <Canvas Width="1672" Height="941">
                <Image Source="pack://application:,,,/Assets/Splash/cmts-splash.png"
                       Canvas.Left="0"
                       Canvas.Top="0"
                       Width="1672"
                       Height="941"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <ProgressBar x:Name="StartupProgressBar"
                             Canvas.Left="605"
                             Canvas.Top="783"
                             Width="462"
                             Height="15"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Style="{StaticResource SplashProgressStyle}"/>

                <TextBlock Canvas.Left="0"
                           Canvas.Top="817"
                           Width="1672"
                           Text="L o a d i n g . . ."
                           Foreground="#FFE5E8EC"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Light"
                           TextAlignment="Center"/>

                <TextBlock x:Name="VersionText"
                           Canvas.Left="0"
                           Canvas.Top="858"
                           Width="1672"
                           Foreground="#FFC9CDD2"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="Light"
                           TextAlignment="Center"/>
            </Canvas>
        </Viewbox>
    </Border>
</Window>
