<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 (not -windows) so testhost runs on Linux CI / this box.
         Pure logic sources are linked from the main tree (no WPF / ScottPlot).
         On Windows you can still `dotnet test` the same project. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ChassisMasterTestSuite.Tests</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Link pure (non-UI) production sources — avoids WPF ProjectReference on Linux.
       Keep in sync with main tree; do not edit copies. -->
  <ItemGroup>
    <Compile Include="..\Core\ChannelIds.cs" Link="Linked\Core\ChannelIds.cs" />
    <Compile Include="..\Core\ChannelInfo.cs" Link="Linked\Core\ChannelInfo.cs" />
    <Compile Include="..\Core\ChannelRegistry.cs" Link="Linked\Core\ChannelRegistry.cs" />
    <Compile Include="..\Core\DataBus.cs" Link="Linked\Core\DataBus.cs" />
    <Compile Include="..\Core\PlotDownsampler.cs" Link="Linked\Core\PlotDownsampler.cs" />
    <Compile Include="..\Core\SampleHistoryBuffer.cs" Link="Linked\Core\SampleHistoryBuffer.cs" />
    <Compile Include="..\Core\VehicleSample.cs" Link="Linked\Core\VehicleSample.cs" />
    <Compile Include="..\Communication\UdpPacket.cs" Link="Linked\Communication\UdpPacket.cs" />
    <Compile Include="..\Communication\UdpPacketSerializer.cs" Link="Linked\Communication\UdpPacketSerializer.cs" />
    <Compile Include="..\Communication\GSpot\GSpotParser.cs" Link="Linked\Communication\GSpot\GSpotParser.cs" />
    <Compile Include="..\Recorder\VboReader.cs" Link="Linked\Recorder\VboReader.cs" />
    <Compile Include="..\Recorder\VboRecorder.cs" Link="Linked\Recorder\VboRecorder.cs" />
  </ItemGroup>

</Project>
