<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Align Light theme to VI skin H (白底红黑 / light-redblack) -->
    <SolidColorBrush x:Key="AppBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C41E3A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#111111"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8A8A8A"/>

    <SolidColorBrush x:Key="ToolButtonBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ToolButtonBorder" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ToolButtonHoverBackground" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="NavHoverBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="NavActiveBackground" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="DangerHoverBackground" Color="#F8E8E8"/>
    <SolidColorBrush x:Key="DangerHoverBorder" Color="#C41E3A"/>
    <SolidColorBrush x:Key="DangerHoverForeground" Color="#9A1830"/>
    <SolidColorBrush x:Key="SplitterBackground" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="MapCanvasBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragBrush" Color="#C41E3A"/>
    <SolidColorBrush x:Key="ScrollBarButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBarGlyphBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="LayoutInactiveBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="LayoutInactiveBorder" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="LayoutInactiveForeground" Color="#5C5C5C"/>

</ResourceDictionary>
