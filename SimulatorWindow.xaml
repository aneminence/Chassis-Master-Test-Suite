<Window x:Class="Chassis_Master_Test_Suite.Simulator.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="CMTS Vehicle Simulator 3D"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource WindowChromeBackground}"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        PreviewKeyDown="Window_KeyDown"
        PreviewKeyUp="Window_KeyUp"
        Closing="Window_Closing">

    <Grid>
        <helix:HelixViewport3D x:Name="Viewport"
                               Background="#FF1A1D22"
                               ShowCoordinateSystem="True"
                               CoordinateSystemLabelForeground="White"
                               ShowViewCube="True"
                               ViewCubeHorizontalPosition="Right"
                               ViewCubeVerticalPosition="Bottom"
                               ZoomExtentsWhenLoaded="False"
                               IsRotationEnabled="True"
                               IsPanEnabled="True"
                               IsZoomEnabled="True"
                               CameraRotationMode="Turntable"
                               ModelUpDirection="0,0,1"
                               Focusable="True">
            <helix:HelixViewport3D.DefaultCamera>
                <PerspectiveCamera Position="-12,0,6"
                                   LookDirection="12,0,-3"
                                   UpDirection="0,0,1"
                                   FieldOfView="60"
                                   NearPlaneDistance="0.1"
                                   FarPlaneDistance="5000"/>
            </helix:HelixViewport3D.DefaultCamera>
            <helix:SunLight/>
            <helix:DefaultLights/>
        </helix:HelixViewport3D>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20"
                Padding="16,10"
                Background="{DynamicResource SimulatorPanelBackground}"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="CMTS VEHICLE SIMULATOR"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Helix 3D / Spa-style elevation / 100 Hz UDP"
                           Foreground="{DynamicResource SimulatorMutedForeground}"
                           FontSize="12"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20"
                Padding="16"
                Width="260"
                Background="{DynamicResource SimulatorPanelBackground}"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="VEHICLE HUD"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Speed" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="SpeedText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Text="0.0 km/h"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Throttle" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="ThrottleText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0%"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Brake" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="BrakeText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0%"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Steering" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="SteeringText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.0°"/>
                </Grid>

                <Grid Grid.Row="5" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Long Accel" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="LongAccelText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.00 m/s²"/>
                </Grid>

                <Grid Grid.Row="6" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Lat Accel" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="LatAccelText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.00 m/s²"/>
                </Grid>

                <Grid Grid.Row="7" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Yaw Rate" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="YawRateText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.00 deg/s"/>
                </Grid>

                <Grid Grid.Row="8" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Heading" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="HeadingText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.0°"/>
                </Grid>

                <Grid Grid.Row="9" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pos X/Y" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock x:Name="PositionText" Grid.Column="1"
                               Foreground="{DynamicResource TextPrimary}" Text="0.0 / 0.0 m"/>
                </Grid>

                <Grid Grid.Row="10" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="UDP" Foreground="{DynamicResource SimulatorMutedForeground}"/>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource OnlineStatusBrush}" Text="100 Hz"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>

