# ============================================================
# CMTS - Chassis Master Test Suite
# Git 忽略规则
# ============================================================
#
# 原则：
# 只提交「源码 + 工程文件」。
# 编译产物、IDE 缓存、测试数据、打包文件都不提交。
# ============================================================


# ============================================================
# 编译输出
# ============================================================

bin/
obj/

# 其它可能的输出目录
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/

# MSBuild / Visual Studio 中间文件
*.binlog
*.tlog
*.cache
*.pdb
*.dll
*.exe
*.lib
*.exp
*.ilk
*.obj
*.o
*.so
*.dylib
*.nupkg
*.snupkg


# ============================================================
# Visual Studio
# ============================================================

.vs/

# 用户本机设置
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# Visual Studio Code
.vscode/


# ============================================================
# 测试数据
# ============================================================

# CMTS 实时记录的 CSV 原始数据。
# 这些是测试数据，不是源码，不要提交。
Recordings/
*.csv
*.vbo

# 但是保留目录占位文件
!Recordings/.gitkeep


# ============================================================
# 打包 / 备份
# ============================================================

# 历史打包快照
*.zip
*.7z
*.rar
*.tar
*.gz

# 本地备份目录
_backup*/
*_backup/


# ============================================================
# 操作系统
# ============================================================

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ============================================================
# 其它
# ============================================================

# NuGet 本地包缓存
packages/
!packages/build/

# 临时文件
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# 调试跟踪
*.log
*.trace
