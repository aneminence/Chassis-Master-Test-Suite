<Window x:Class="Chassis_Master_Test_Suite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chassis_Master_Test_Suite.Controls"
        Title="Chassis Master Test Suite"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="900"
        Width="1400"
        MinHeight="760"
        MinWidth="1200"
        Background="#0B0E12"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        所有深色主题样式（SplitterStyle / NavButtonStyle / ToolButtonStyle /
        DangerButtonStyle / DarkTextBoxStyle / DarkComboBoxStyle /
        DarkCheckBoxStyle，以及 CheckBox、ComboBox 的隐式样式）都已统一放在
        App.xaml 的 Application.Resources 中。

        原因：曲线区里每个 Plot 的控件（Plot Name 输入框、Auto Y、+ Channel、
        Remove Plot、Channel 下拉、× 按钮）都是 MainWindow.xaml.cs 用代码创建的，
        拿不到 Window.Resources 里的样式，所以必须上移到 Application 级。
    -->

    <!-- ================================================================
         主布局
         ================================================================ -->

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <!-- 0 顶部栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 1 导航栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 2 上方三区（可拖动调整高度） -->
            <RowDefinition Height="*" MinHeight="200"/>
            <!-- 3 横向分隔条 -->
            <RowDefinition Height="Auto"/>
            <!-- 4 下方曲线区（可拖动调整高度） -->
            <RowDefinition Height="*" MinHeight="240"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             行 0：顶部栏
             ============================================================ -->

        <Border Grid.Row="0"
                Background="#12171E"
                BorderBrush="#1E2530"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,9"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="CMTS"
                               Foreground="#C8A34A"
                               FontSize="19"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>

                    <Border Width="1"
                            Height="20"
                            Background="#26303C"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="Chassis Master Test Suite"
                               Foreground="#E6EAF0"
                               FontSize="14"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- 网络状态 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">

                    <Ellipse Width="7"
                             Height="7"
                             Fill="#3FBF6F"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>

                    <TextBlock Text="Online"
                               Foreground="#8A94A6"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- 右侧：录制控制 + 时钟 -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="RecordButton"
                            Style="{StaticResource ToolButtonStyle}"
                            Foreground="#E08A8A"
                            Margin="0,0,6,0"
                            Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RecordGlyphText"
                                       Text="●"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecordLabelText"
                                       Text="Start"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopRecordButton"
                            Content="■ Stop"
                            Style="{StaticResource ToolButtonStyle}"
                            Foreground="#8A94A6"
                            IsEnabled="False"
                            Margin="0,0,14,0"
                            Click="StopRecordButton_Click"/>

                    <TextBlock Text="Elapsed"
                               Foreground="#5A6474"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBlock x:Name="ElapsedTimeText"
                               Text="--"
                               Foreground="#8A94A6"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <TextBlock x:Name="ClockText"
                               Text="--"
                               Foreground="#C3CBD8"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ============================================================
             行 1：导航栏（静态视觉，后续开发）
             ============================================================ -->

        <Border Grid.Row="1"
                Background="#12171E"
                BorderBrush="#1E2530"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,6"
                Margin="0,0,0,8">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="DashboardNavButton"
                        Content="⊞   Dashboard"
                        Style="{StaticResource NavButtonActiveStyle}"
                        Click="DashboardNavButton_Click"/>

                <Button x:Name="DataNavButton"
                        Content="▤   Data"
                        Style="{StaticResource NavButtonStyle}"
                        IsEnabled="False"/>

                <Button x:Name="AnalysisNavButton"
                        Content="⌁   Analysis"
                        Style="{StaticResource NavButtonStyle}"
                        IsEnabled="False"/>

                <Button x:Name="ReplayNavButton"
                        Content="▷   Replay"
                        Style="{StaticResource NavButtonStyle}"
                        Click="ReplayNavButton_Click"/>

                <Button x:Name="SettingsNavButton"
                        Content="⚙   Settings"
                        Style="{StaticResource NavButtonStyle}"
                        IsEnabled="False"/>

            </StackPanel>

        </Border>

        <!-- ============================================================
             行 2：上方三区（① Dashboard / ② Test Results / ③ Track Map）
             ============================================================ -->

        <Grid Grid.Row="2">

            <!-- Dashboard 页：上方三区 -->
            <Grid x:Name="DashboardPage">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.6*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ① Dashboard -->
            <controls:DashboardPanel x:Name="DashboardPanelControl"
                                     Grid.Column="0"
                                     Margin="0,0,4,0"/>

            <!-- 竖向分隔条 1 -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource SplitterStyle}"/>

            <!-- ② Test Results -->
            <controls:TestResultsPanel Grid.Column="2"
                                       Margin="4,0,4,0"/>

            <!-- 竖向分隔条 2 -->
            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource SplitterStyle}"/>

            <!-- ③ Track Map -->
            <controls:TrackMapPanel x:Name="TrackMapPanelControl"
                                    Grid.Column="4"
                                    Margin="4,0,0,0"/>

            </Grid>

            <!-- Replay 页 -->
            <Border x:Name="ReplayPage"
                    Background="#12171E"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    Margin="0,0,0,4">

                <StackPanel Margin="24,20,24,20">

                    <TextBlock Text="▷  Replay"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#E6EAF0"/>

                    <TextBlock Text="Load a recorded VBO file and analyse it offline."
                               FontSize="11"
                               Foreground="#8A94A6"
                               Margin="0,6,0,18"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="OpenVboButton"
                                Content="📂  Open VBO…"
                                Style="{StaticResource ToolButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                Click="OpenVboButton_Click"/>

                        <TextBlock x:Name="ReplayFileText"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   FontSize="11"
                                   Foreground="#8A94A6"
                                   Text="No file loaded"/>

                    </StackPanel>

                    <TextBlock x:Name="ReplayInfoText"
                               Margin="0,16,0,0"
                               FontSize="11"
                               Foreground="#8A94A6"
                               Text=""/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ============================================================
             行 3：横向分隔条（可拖动调整上下高度）
             ============================================================ -->

        <GridSplitter Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="0,3,0,3"
                      Style="{StaticResource SplitterStyle}"/>

        <!-- ============================================================
             行 4：下方曲线区（④ Test Data Curves）

             原有多 Plot / 多 Channel 功能全部保留。
             内部独立 ScrollViewer：溢出时只滚动本区域，
             上方三个区域固定不动。
             ============================================================ -->

        <Border Grid.Row="4"
                Background="#12171E"
                BorderBrush="#1E2530"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--  曲线区标题栏  -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,32,0">

                        <TextBlock Text="⌁"
                                   Foreground="#8A94A6"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Test Data Curves"
                                   Foreground="#E6EAF0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- 参数控件 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- X Axis -->
                        <TextBlock Text="X Axis"
                                   Foreground="#8A94A6"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox x:Name="XAxisSelector"
                                  Width="130"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectionChanged="AxisSelector_SelectionChanged"
                                  Margin="0,0,16,0"/>

                        <!-- X Auto Scale -->
                        <CheckBox x:Name="XAxisAutoScaleCheckBox"
                                  Content="X Auto Scale"
                                  Style="{StaticResource DarkCheckBoxStyle}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Checked="XAxisAutoScaleCheckBox_Changed"
                                  Unchecked="XAxisAutoScaleCheckBox_Changed"/>

                        <!-- 操作按钮 -->
                        <Button x:Name="AddPlotButton"
                                Content="+ Add Plot"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,6,0"
                                Click="AddPlotButton_Click"/>

                        <Button x:Name="ResetViewButton"
                                Content="Reset View"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,6,0"
                                Click="ResetViewButton_Click"/>

                        <Button x:Name="SimulatorButton"
                                Content="Simulator"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="SimulatorButton_Click"/>

                    </StackPanel>

                    <!-- 右侧：网络质量 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="Rx"
                                   Foreground="#5A6474"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="ReceivedPacketsText"
                                   Text="0"
                                   Foreground="#8A94A6"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Lost"
                                   Foreground="#5A6474"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="LostPacketsText"
                                   Text="0"
                                   Foreground="#8A94A6"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="OOO"
                                   Foreground="#5A6474"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="OutOfOrderPacketsText"
                                   Text="0"
                                   Foreground="#8A94A6"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>

                        <!-- 保留但不在标题栏显示的计数控件 -->
                        <TextBlock x:Name="ValidPacketsText"
                                   Text="0"
                                   Visibility="Collapsed"/>

                    </StackPanel>

                </Grid>

                <!--  曲线容器（独立滚动）  -->

                <Border Grid.Row="1"
                        Background="#0E131A"
                        BorderBrush="#1E2530"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">

                    <ScrollViewer x:Name="PlotScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="6">

                        <StackPanel x:Name="PlotContainer"/>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>
