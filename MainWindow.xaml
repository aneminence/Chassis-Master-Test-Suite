<Window x:Class="Chassis_Master_Test_Suite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Chassis_Master_Test_Suite.Controls"
        Title="Chassis Master Test Suite"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="900"
        Width="1400"
        MinHeight="760"
        MinWidth="1200"
        Background="{DynamicResource AppBackground}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        所有深色主题样式（SplitterStyle / NavButtonStyle / ToolButtonStyle /
        DangerButtonStyle / DarkTextBoxStyle / DarkPasswordBoxStyle /
        DarkComboBoxStyle / DarkCheckBoxStyle，以及 CheckBox、ComboBox 的隐式样式）都已统一放在
        App.xaml 的 Application.Resources 中。

        原因：曲线区里每个 Plot 的控件（Plot Name 输入框、Auto Y、+ Channel、
        Remove Plot、Channel 下拉、× 按钮）都是 MainWindow.xaml.cs 用代码创建的，
        拿不到 Window.Resources 里的样式，所以必须上移到 Application 级。
    -->

    <!-- ================================================================
         主布局
         ================================================================ -->

    <Grid Margin="10">

                <Grid.RowDefinitions>
            <!-- 0 toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 1 top panels (Dashboard / Test Results / Map) -->
            <RowDefinition x:Name="TopPanelsRow" Height="*" MinHeight="200"/>
            <!-- 2 horizontal splitter -->
            <RowDefinition Height="Auto"/>
            <!-- 3 curves -->
            <RowDefinition x:Name="CurvesRow" Height="*" MinHeight="240"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             行 0：顶部栏
             ============================================================ -->

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,9"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + VBTS-style actions + mode tools + file chips -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="CMTS"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="19"
                               FontWeight="Bold"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>

                    <Border Width="1"
                            Height="20"
                            Background="{DynamicResource ToolButtonBorder}"
                            Margin="12,0,10,0"
                            VerticalAlignment="Center"/>

                    <!-- Layout: VBTS-style clickable region map (Dashboard / Chart / Test Results / Map) -->
                    <Menu Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          Margin="0,0,4,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource DarkMenuStyle}">
                        <MenuItem x:Name="LayoutMenuRoot"
                                  Header="Layout ▾"
                                  Style="{StaticResource DarkTopMenuItemStyle}"
                                  ToolTip="Show or hide workspace panels">
                            <MenuItem Style="{StaticResource LayoutMapHostMenuItemStyle}"
                                      StaysOpenOnClick="True"
                                      Focusable="False">
                                <MenuItem.Header>
                                    <Border Background="{DynamicResource MenuDropdownBackground}"
                                            BorderBrush="{DynamicResource ToolButtonBorder}"
                                            BorderThickness="0"
                                            Padding="6"
                                            Width="252">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="56"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <!-- Top: matches CMTS top panels -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="LayoutCellDashboard"
                                                        Grid.Column="0"
                                                        Style="{StaticResource LayoutRegionActiveStyle}"
                                                        Tag="Dashboard"
                                                        Cursor="Hand"
                                                        ToolTip="Toggle Dashboard"
                                                        MouseLeftButtonUp="LayoutRegion_Click">
                                                    <TextBlock Text="Dashboard"
                                                               Style="{StaticResource LayoutRegionLabelStyle}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"/>
                                                </Border>

                                                <Border x:Name="LayoutCellTestResults"
                                                        Grid.Column="2"
                                                        Style="{StaticResource LayoutRegionActiveStyle}"
                                                        Tag="TestResults"
                                                        Cursor="Hand"
                                                        ToolTip="Toggle Test Results"
                                                        MouseLeftButtonUp="LayoutRegion_Click">
                                                    <TextBlock Text="Test Results"
                                                               Style="{StaticResource LayoutRegionLabelStyle}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"/>
                                                </Border>

                                                <Border x:Name="LayoutCellMap"
                                                        Grid.Column="4"
                                                        Style="{StaticResource LayoutRegionActiveStyle}"
                                                        Tag="Map"
                                                        Cursor="Hand"
                                                        ToolTip="Toggle Map"
                                                        MouseLeftButtonUp="LayoutRegion_Click">
                                                    <TextBlock Text="Map"
                                                               Style="{StaticResource LayoutRegionLabelStyle}"
                                                               TextAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <!-- Bottom: Chart / curves -->
                                            <Border x:Name="LayoutCellChart"
                                                    Grid.Row="2"
                                                    Style="{StaticResource LayoutRegionActiveStyle}"
                                                    Tag="Chart"
                                                    Cursor="Hand"
                                                    ToolTip="Toggle Chart"
                                                    MouseLeftButtonUp="LayoutRegion_Click">
                                                <TextBlock Text="Chart"
                                                           Style="{StaticResource LayoutRegionLabelStyle}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Reset -->
                                            <Border x:Name="LayoutCellReset"
                                                    Grid.Row="4"
                                                    Background="{DynamicResource LayoutInactiveBackground}"
                                                    BorderBrush="{DynamicResource LayoutInactiveBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Cursor="Hand"
                                                    ToolTip="Reset layout to default sizes and visibility"
                                                    MouseLeftButtonUp="LayoutReset_Click">
                                                <TextBlock Text="Reset"
                                                           Foreground="{DynamicResource LayoutInactiveForeground}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
<Button x:Name="LoadVboButton"
                            Content="Load"
                            Style="{StaticResource ToolButtonStyle}"
                            Margin="0,0,4,0"
                            Padding="12,4"
                            Click="OpenVboButton_Click"
                            ToolTip="Open VBO file(s)"/>

                    <Button x:Name="OnlineModeButton"
                            Content="Online"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Margin="0,0,4,0"
                            Padding="12,4"
                            Click="OnlineModeButton_Click"
                            ToolTip="Remote live data (UDP / GSpot / Simulator)"/>

                    <Button x:Name="OfflineModeButton"
                            Content="Offline"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="0,0,4,0"
                            Padding="12,4"
                            Click="OfflineModeButton_Click"
                            ToolTip="VBO replay and multi-file compare"/>

                    <Button x:Name="ClearOfflineButton"
                            Content="Clear"
                            Style="{StaticResource ToolButtonStyle}"
                            Foreground="{DynamicResource DangerHoverForeground}"
                            Margin="0,0,8,0"
                            Click="CloseAllVboButton_Click"
                            ToolTip="Close all opened VBO files"/>

                    <!-- Online tools (UDP / GSpot / Simulator) -->
                    <StackPanel x:Name="OnlineToolsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="1"
                                Height="18"
                                Background="{DynamicResource ToolButtonBorder}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>

                        <Button x:Name="UdpSourceButton"
                                Content="UDP"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,4,0"
                                Click="UdpSourceButton_Click"
                                ToolTip="Local UDP / Simulator data source"/>

                        <Button x:Name="GSpotButton"
                                Content="GSpot…"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,4,0"
                                Click="GSpotButton_Click"
                                ToolTip="GSpot WebSocket (room + password)"/>

                        <Button x:Name="SimulatorButton"
                                Content="Simulator"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,4,0"
                                Click="SimulatorButton_Click"/>

                        <Button x:Name="StopOnlineButton"
                                Content="Stop"
                                Style="{StaticResource ToolButtonStyle}"
                                Foreground="{DynamicResource DangerHoverForeground}"
                                Click="StopOnlineButton_Click"
                                ToolTip="Stop the current online data source"/>
                    </StackPanel>

                </StackPanel>

<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,16,0">

                    <Ellipse x:Name="ConnectionDot"
                             Width="7"
                             Height="7"
                             Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>

                    <TextBlock x:Name="ConnectionStatusText"
                               Text="Offline"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               ToolTip="数据源连接状态"/>

                </StackPanel>

                <!-- 右侧：录制控制 + 时钟 -->
                                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Language split-button: left toggles 中↔EN, right chevron = other languages -->
                    <Border x:Name="LanguageSplitBorder"
                            Style="{StaticResource ThemeSplitBorderActiveStyle}"
                            Height="26"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LanguageToggleButton"
                                    Content="中"
                                    Style="{StaticResource ThemeSplitPartStyle}"
                                    FontWeight="SemiBold"
                                    Height="24"
                                    MinWidth="28"
                                    Click="LanguageToggle_Click"
                                    ToolTip="切换中文 / 英文"
                                    VerticalAlignment="Center"/>
                            <Border Width="1"
                                    Margin="0,4"
                                    Background="{DynamicResource ToolButtonBorder}"
                                    VerticalAlignment="Stretch"/>
                            <Button x:Name="LanguageMoreButton"
                                    Content="▾"
                                    Style="{StaticResource ThemeSplitChevronStyle}"
                                    Height="24"
                                    Click="LanguageMore_Click"
                                    ToolTip="其它语言"
                                    VerticalAlignment="Center">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="LanguageMoreMenu"
                                                 Background="{DynamicResource PanelBackground}"
                                                 BorderBrush="{DynamicResource ToolButtonBorder}"
                                                 BorderThickness="1">
                                        <MenuItem x:Name="LangZhItem"
                                                  Header="中文"
                                                  Style="{StaticResource DarkMenuItemStyle}"
                                                  Click="LangZh_Click"/>
                                        <MenuItem x:Name="LangEnItem"
                                                  Header="English"
                                                  Style="{StaticResource DarkMenuItemStyle}"
                                                  Click="LangEn_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="LangMorePlaceholderItem"
                                                  Header="更多语言…"
                                                  Style="{StaticResource DarkMenuItemStyle}"
                                                  IsEnabled="False"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Theme split-button: left toggles Light↔Dark, right chevron = other themes -->
                    <Border x:Name="ThemeSplitBorder"
                            Style="{StaticResource ThemeSplitBorderActiveStyle}"
                            Height="26"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThemeToggleButton"
                                    Content="暗"
                                    Style="{StaticResource ThemeSplitPartStyle}"
                                    FontWeight="SemiBold"
                                    Height="24"
                                    Click="ThemeToggle_Click"
                                    ToolTip="切换明亮 / 暗黑"
                                    VerticalAlignment="Center"/>
                            <Border Width="1"
                                    Margin="0,4"
                                    Background="{DynamicResource ToolButtonBorder}"
                                    VerticalAlignment="Stretch"/>
                            <Button x:Name="ThemeMoreButton"
                                    Content="▾"
                                    Style="{StaticResource ThemeSplitChevronStyle}"
                                    Height="24"
                                    Click="ThemeMore_Click"
                                    ToolTip="其它主题"
                                    VerticalAlignment="Center">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ThemeMoreMenu"
                                                 Background="{DynamicResource PanelBackground}"
                                                 BorderBrush="{DynamicResource ToolButtonBorder}"
                                                 BorderThickness="1">
                                        <MenuItem x:Name="ThemeIconGoldItem"
                                                  Header="图标暖金"
                                                  Style="{StaticResource DarkMenuItemStyle}"
                                                  IsCheckable="True"
                                                  Click="ThemeIconGold_Click"
                                                  ToolTip="Warm gold dark chrome (VI Variant D)"/>
                                        <MenuItem x:Name="ThemeCustomItem"
                                                  Header="自定义…"
                                                  Style="{StaticResource DarkMenuItemStyle}"
                                                  IsEnabled="False"
                                                  Click="ThemeCustom_Click"
                                                  ToolTip="Custom theme colors (placeholder)"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Width="1"
                            Height="18"
                            Background="{DynamicResource ToolButtonBorder}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"/>

                    <Button x:Name="RecordButton"

                            Style="{StaticResource ToolButtonStyle}"
                            Foreground="{DynamicResource DangerHoverForeground}"
                            Margin="0,0,6,0"
                            Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RecordGlyphText"
                                       Text="●"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecordLabelText"
                                       Text="Start"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopRecordButton"
                            Content="■ Stop"
                            Style="{StaticResource ToolButtonStyle}"
                            Foreground="{DynamicResource TextSecondary}"
                            IsEnabled="False"
                            Margin="0,0,14,0"
                            Click="StopRecordButton_Click"/>

                    <TextBlock x:Name="ElapsedLabelText"
                               Text="Elapsed"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <TextBlock x:Name="ElapsedTimeText"
                               Text="--"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <TextBlock x:Name="ClockText"
                               Text="--"
                               Foreground="{DynamicResource TextBright}"
                               FontSize="12"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ============================================================
             行 2：上方三区（① Dashboard / ② Test Results / ③ Track Map）
             ============================================================ -->

        <Grid Grid.Row="1">

            <!-- Dashboard 页：上方三区 -->
            <Grid x:Name="DashboardPage">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DashboardColumn" Width="1.2*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TestResultsColumn" Width="1*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="MapColumn" Width="1.6*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ① Dashboard -->
            <controls:DashboardPanel x:Name="DashboardPanelControl"
                                     Grid.Column="0"
                                     Margin="0,0,4,0"/>

            <!-- 竖向分隔条 1 -->
            <GridSplitter x:Name="DashboardSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource SplitterStyle}"/>

            <!-- ② Test Results -->
            <controls:TestResultsPanel x:Name="TestResultsPanelControl"
                                       Grid.Column="2"
                                       Margin="4,0,4,0"/>

            <!-- 竖向分隔条 2 -->
            <GridSplitter x:Name="MapSplitter"
                          Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource SplitterStyle}"/>

            <!-- ③ Track Map -->
            <controls:TrackMapPanel x:Name="TrackMapPanelControl"
                                    Grid.Column="4"
                                    Margin="4,0,0,0"/>

            </Grid>

            <!-- Replay 页 -->
            <Border x:Name="ReplayPage"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    Margin="0,0,0,4">

                <StackPanel Margin="24,20,24,20">

                    <TextBlock x:Name="ReplayTitleText"
                               Text="▷  Replay"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <TextBlock x:Name="ReplayHintText"
                               Text="Load a recorded VBO file and analyse it offline."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,6,0,18"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="ReplayPageOpenVboButton"
                                Content="📂  Open VBO…"
                                Style="{StaticResource ToolButtonStyle}"
                                Height="30"
                                Padding="14,0"
                                Click="OpenVboButton_Click"/>

                        <TextBlock x:Name="ReplayFileText"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="No file loaded"/>

                    </StackPanel>

                    <TextBlock x:Name="ReplayInfoText"
                               Margin="0,16,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Text=""/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ============================================================
             行 3：横向分隔条（可拖动调整上下高度）
             ============================================================ -->

        <GridSplitter x:Name="CurvesRowSplitter"
                      Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="0,3,0,3"
                      Style="{StaticResource SplitterStyle}"/>

        <!-- ============================================================
             行 4：下方曲线区（④ Test Data Curves）

             原有多 Plot / 多 Channel 功能全部保留。
             内部独立 ScrollViewer：溢出时只滚动本区域，
             上方三个区域固定不动。
             ============================================================ -->

        <Border x:Name="CurvesPanelBorder"
                Grid.Row="3"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--  曲线区标题栏  -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,32,0">

                        <TextBlock Text="⌁"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="CurvesTitleText"
                                   Text="Test Data Curves"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- 参数控件 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- X Axis -->
                        <TextBlock x:Name="XAxisLabelText"
                                   Text="X Axis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox x:Name="XAxisSelector"
                                  Width="130"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectionChanged="AxisSelector_SelectionChanged"
                                  Margin="0,0,16,0"/>

                        <!-- X Auto Scale -->
                        <CheckBox x:Name="XAxisAutoScaleCheckBox"
                                  Content="X Auto Scale"
                                  Style="{StaticResource DarkCheckBoxStyle}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Checked="XAxisAutoScaleCheckBox_Changed"
                                  Unchecked="XAxisAutoScaleCheckBox_Changed"/>

                        <!-- 操作按钮 -->
                        <Button x:Name="AddPlotButton"
                                Content="+ Add Plot"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,6,0"
                                Click="AddPlotButton_Click"/>

                        <Button x:Name="ResetViewButton"
                                Content="Reset View"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,6,0"
                                Click="ResetViewButton_Click"/>

                    </StackPanel>

                    <!-- 右侧：网络质量 -->
                    <!-- File list: always expanded, uses stretch column -->
                <DockPanel Grid.Column="2"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           LastChildFill="True">
                    <TextBlock x:Name="FilesLabelText"
                               DockPanel.Dock="Left"
                               Text="Files"
                               Foreground="{DynamicResource TextMuted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="OfflineFilesPanel"
                                    Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="Rx"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="ReceivedPacketsText"
                                   Text="0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="Lost"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="LostPacketsText"
                                   Text="0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="OOO"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock x:Name="OutOfOrderPacketsText"
                                   Text="0"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>

                        <!-- 保留但不在标题栏显示的计数控件 -->
                        <TextBlock x:Name="ValidPacketsText"
                                   Text="0"
                                   Visibility="Collapsed"/>

                    </StackPanel>

                </Grid>

                <!--  曲线容器（独立滚动）  -->

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ClipToBounds="True">

                    <!-- Plots stack with pixel heights and overflow; wheel/scrollbar to scroll -->
                    <ScrollViewer x:Name="PlotScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  PanningMode="VerticalOnly">
                        <Grid x:Name="PlotContainer" Margin="6"/>
                    </ScrollViewer>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>
