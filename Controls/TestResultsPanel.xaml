<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TestResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Chassis_Master_Test_Suite.Localization"
             Background="{DynamicResource PanelBackground}">

    <UserControl.Resources>
        <Style x:Key="ResultsDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ComboItemSelectedBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ConditionsRowDef" Height="200" MinHeight="0"/>
                <RowDefinition x:Name="SplitterRowDef" Height="6"/>
                <RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Test Results"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ToggleConditionsButton"
                            Content="Hide conditions"
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="12,0,0,0"
                            Padding="10,2"
                            Click="ToggleConditionsButton_Click"
                            ToolTip="Collapse / expand the conditions area above the results table"/>
                </StackPanel>

                <Button x:Name="SessionButton"
                        Grid.Column="1"
                        Content="Session"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="SessionButton_Click"
                        ToolTip="Edit session metadata written to VBO [SessionData]"/>
            </Grid>

            <ScrollViewer x:Name="ConditionsScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Border
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="TypeLabel"
                                   Text="Type"
                                   Style="{StaticResource ParamLabelStyle}"/>
                        <ComboBox x:Name="TestTypeCombo"
                                  Width="110"
                                  Height="28"
                                  Margin="0,0,14,4"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectionChanged="TestTypeCombo_SelectionChanged">
                            <ComboBoxItem x:Name="TypeAccelItem" Content="Accel" IsSelected="True" Tag="Accel"/>
                            <ComboBoxItem x:Name="TypeDecelItem" Content="Decel" Tag="Decel"/>
                            <ComboBoxItem x:Name="TypeCustomItem" Content="Custom" Tag="Custom"/>
                            <ComboBoxItem x:Name="TypeGateItem" Content="Gate" Tag="Gate"/>
                            <ComboBoxItem x:Name="TypeLapTimeItem" Content="Lap Time" Tag="LapTime"/>
                        </ComboBox>

                        <TextBlock x:Name="ChannelLabel"
                                   Text="Channel"
                                   Style="{StaticResource ParamLabelStyle}"
                                   Visibility="Collapsed"/>
                        <ComboBox x:Name="ChannelCombo"
                                  Width="120"
                                  Height="28"
                                  Margin="0,0,14,4"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Visibility="Collapsed"/>
                    </WrapPanel>

                    
                                        <StackPanel x:Name="GatePickPanel" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock x:Name="StartConditionsLabel" Text="Start Condition(s)" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="StartWhenLabel" Text="Start When" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="GateStartCombo" Width="160" Height="28" Margin="0,0,14,4"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      SelectionChanged="GateStartCombo_SelectionChanged"
                                      ToolTip="Start When: named gate"/>
                        </WrapPanel>

                        <TextBlock x:Name="EndConditionsLabel" Text="End Condition(s)" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="EndWhenLabel" Text="End When" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="GateEndCombo" Width="160" Height="28" Margin="0,0,14,4"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      SelectionChanged="GateEndCombo_SelectionChanged"
                                      ToolTip="End When: named gate"/>
                        </WrapPanel>

                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="PassConditionsLabel" Text="Pass Condition(s)" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="AddPassButton" Content="+ Add Pass" Style="{StaticResource HeaderButtonStyle}"
                                    HorizontalAlignment="Right" Click="AddPassCondition_Click"
                                    ToolTip="Add Pass Condition: Channel Min–Max At gate"/>
                        </Grid>
                                                <ItemsControl x:Name="PassConditionsHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding [Results.Channel], Source={x:Static loc:LocBinder.Instance}}" Style="{StaticResource ParamLabelStyle}"/>
                                        <ComboBox Width="180" Height="28" Margin="0,0,8,4"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  ItemsSource="{Binding ChannelOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding ChannelId, Mode=TwoWay}"/>
                                        <TextBlock Text="{Binding [Results.Min], Source={x:Static loc:LocBinder.Instance}}" Style="{StaticResource ParamLabelStyle}"/>
                                        <TextBox Width="56" Height="28" Margin="0,0,8,4"
                                                 Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding [Results.Max], Source={x:Static loc:LocBinder.Instance}}" Style="{StaticResource ParamLabelStyle}"/>
                                        <TextBox Width="56" Height="28" Margin="0,0,8,4"
                                                 Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding [Results.At], Source={x:Static loc:LocBinder.Instance}}" Style="{StaticResource ParamLabelStyle}"/>
                                        <ComboBox Width="140" Height="28" Margin="0,0,8,4"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  ItemsSource="{Binding GateChoices}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding AtGateId, Mode=TwoWay}"/>
                                        <Button Content="{Binding [Results.Remove], Source={x:Static loc:LocBinder.Instance}}" Style="{StaticResource HeaderButtonStyle}"
                                                Margin="0,0,0,4" Padding="8,2"
                                                Click="RemovePassCondition_Click"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="LapTimePanel" Margin="0,0,0,8" Visibility="Collapsed">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock x:Name="LapGateLabel" Text="Start / Finish" Style="{StaticResource ParamLabelStyle}"/>
                            <ComboBox x:Name="LapGateCombo" Width="160" Height="28" Margin="0,0,12,4"
                                      Style="{StaticResource DarkComboBoxStyle}"/>
                            <Button x:Name="AddSectorButton" Content="+ Add Sector" Style="{StaticResource HeaderButtonStyle}"
                                    Margin="0,0,0,4" Click="AddSectorButton_Click"/>
                        </WrapPanel>
                        <ItemsControl x:Name="SectorGatesHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding NumberText}" Width="58" Style="{StaticResource ParamLabelStyle}"/>
                                        <ComboBox Width="160" Height="28" Margin="0,0,6,0"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  ItemsSource="{Binding GateChoices}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding GateId, Mode=TwoWay}"/>
                                        <Button Content="↑" Width="28" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0"
                                                Click="MoveSectorUp_Click"/>
                                        <Button Content="↓" Width="28" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0"
                                                Click="MoveSectorDown_Click"/>
                                        <Button Content="{Binding [Results.Remove], Source={x:Static loc:LocBinder.Instance}}"
                                                Style="{StaticResource HeaderButtonStyle}" Click="RemoveSector_Click"/>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
<WrapPanel x:Name="ThresholdPanel" Orientation="Horizontal">
                        <TextBlock x:Name="StartLabel"
                                   Text="Start"
                                   Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox x:Name="StartThresholdBox"
                                 Width="72"
                                 Height="28"
                                 Margin="0,0,4,4"
                                 Text="0"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="km/h"
                                   Foreground="{DynamicResource MapPlaceholderForeground}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,4"/>

                        <TextBlock x:Name="EndLabel"
                                   Text="End"
                                   Style="{StaticResource ParamLabelStyle}"/>
                        <TextBox x:Name="EndThresholdBox"
                                 Width="72"
                                 Height="28"
                                 Margin="0,0,4,4"
                                 Text="100"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="km/h"
                                   Foreground="{DynamicResource MapPlaceholderForeground}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,4"/>

                        <Button x:Name="ComputeButton"
                                Content="Compute"
                                Style="{StaticResource ToolButtonStyle}"
                                Margin="0,0,8,4"
                                Padding="14,4"
                                Click="ComputeButton_Click"
                                ToolTip="Compute across ALL open VBO files / live history"/>

                        <Button x:Name="ExportCsvButton"
                                Content="Export CSV"
                                Style="{StaticResource HeaderButtonStyle}"
                                Margin="0,0,0,4"
                                Click="ExportCsvButton_Click"
                                IsEnabled="False"
                                ToolTip="Export current results to CSV"/>
                    </WrapPanel>


                    <Button x:Name="MathsChannelsButton"
                            Content="Maths Channels..."
                            Style="{StaticResource HeaderButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="MathsChannelsButton_Click"
                            ToolTip="Define calculated channels (VBTS-style editor)"/>
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               Text="Compute scans every open VBO. Check rows to overlay-compare on charts."/>
                </StackPanel>
            </Border>
            </ScrollViewer>

            <GridSplitter x:Name="ConditionsSplitter"
                          Grid.Row="2"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="{DynamicResource BorderBrushSoft}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          ToolTip="Drag to resize conditions / results"/>


            <DataGrid x:Name="ResultsGrid"
                      Grid.Row="3"
                      Style="{StaticResource ResultsDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" CanUserResize="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="SelectAllCheckBox"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsThreeState="True"
                                      Focusable="False"
                                      ToolTip="Select all / clear"
                                      PreviewMouseLeftButtonDown="SelectAllCheckBox_PreviewMouseLeftButtonDown"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColRun" Header="#"
                                        Binding="{Binding RunNumber}"
                                        IsReadOnly="True"
                                        Width="36"/>
                    <DataGridTextColumn x:Name="ColSource" Header="Source"
                                        Binding="{Binding SourceText}"
                                        IsReadOnly="True"
                                        Width="140"/>
                    <DataGridTextColumn x:Name="ColStart" Header="Start"
                                        Binding="{Binding StartTimeText}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn x:Name="ColEnd" Header="End"
                                        Binding="{Binding EndTimeText}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn x:Name="ColDuration" Header="Duration s"
                                        Binding="{Binding DurationText}"
                                        IsReadOnly="True"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding DurationBrush}"/>
                                <Setter Property="FontWeight" Value="{Binding DurationWeight}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColDeltaV" Header="dV km/h"
                                        Binding="{Binding DeltaVText}"
                                        IsReadOnly="True"
                                        Width="72"/>
                    <DataGridTextColumn x:Name="ColDist" Header="Dist m"
                                        Binding="{Binding DistanceText}"
                                        IsReadOnly="True"
                                        Width="72"/>
                    <DataGridTextColumn x:Name="ColPass" Header="Pass"
                                        Binding="{Binding PassText}"
                                        IsReadOnly="True"
                                        Width="56"/>
                    <DataGridTemplateColumn x:Name="ColPassValues" Header="Pass values"
                                            Width="SizeToCells"
                                            MinWidth="120"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding PassValues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3"
                                                    Padding="6,2"
                                                    Margin="0,1,6,1"
                                                    Background="{Binding ChipBackground}"
                                                    ToolTip="{Binding ToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="10"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ValueText}"
                                                               Foreground="{Binding ValueBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="FooterHintText"
                       Grid.Row="4"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource MapHintForeground}"
                       FontSize="10"
                       Text="Multi-file Compute + checkbox compare (X = seconds from each run start). Single row focus keeps span annotation."/>
        </Grid>
    </Border>
</UserControl>
