<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TestResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12171E">

    <Border BorderBrush="#1E2530"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="▤"
                               Foreground="#8A94A6"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Test Results"
                               Foreground="#E6EAF0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Customize"
                        Style="{StaticResource HeaderButtonStyle}"
                        IsEnabled="False"/>

            </Grid>

            <!-- 内容区（未开发） -->
            <Border Grid.Row="1"
                    Background="#0E131A"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="4">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Test Results"
                               Foreground="#4A5568"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Automatic calculation with user-defined boundary conditions"
                               Foreground="#39424F"
                               FontSize="11"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Not implemented yet"
                               Foreground="#C8A34A"
                               FontSize="11"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>
