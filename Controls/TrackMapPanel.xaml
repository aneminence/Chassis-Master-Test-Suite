<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource PanelBackground}">

    <Border BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="◎"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="14"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Text="Track Map"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="Mode2DButton" Content="2D" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,4,0"
                            Click="Mode2DButton_Click" ToolTip="Use the classic 2D track map"/>
                    <Button x:Name="Mode3DButton" Content="3D" Style="{StaticResource HeaderButtonStyle}"
                            Click="Mode3DButton_Click" ToolTip="Use the interactive 3D globe"/>
                </StackPanel>

                <StackPanel x:Name="Map2DToolbar" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <CheckBox x:Name="BasemapCheck"
                              Content="Basemap"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Checked="BasemapCheck_Changed"
                              Unchecked="BasemapCheck_Changed"
                              ToolTip="Toggle online map tiles under the track"/>
                    <ComboBox x:Name="BasemapSourceCombo"
                              Width="200"
                              Height="26"
                              Margin="0,0,10,0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="BasemapSourceCombo_SelectionChanged"
                              ToolTip="Basemap source (Ovi-style)"/>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="AddGateButton" Content="Add Gate" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="AddGateButton_Click" ToolTip="Click track to place a new named gate"/>
                    <ComboBox x:Name="GateCombo" Width="130" Height="26" Margin="0,0,6,0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="GateCombo_SelectionChanged"
                              ToolTip="Select gate"/>
                    <TextBlock x:Name="GateWidthLabel" Text="W" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="GateWidthBox" Width="44" Height="26" Margin="0,0,2,0"
                             Text="20" Style="{StaticResource DarkTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             ToolTip="Gate width (meters)"
                             LostFocus="GateWidthBox_LostFocus" KeyDown="GateWidthBox_KeyDown"/>
                    <TextBlock Text="m" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="RenameGateButton" Content="Rename" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="RenameGateButton_Click" ToolTip="Rename selected gate"/>
                    <Button x:Name="DeleteGateButton" Content="Delete" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="DeleteGateButton_Click" ToolTip="Delete selected gate"/>
                    <Button x:Name="DeleteAllGatesButton" Content="Delete All" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="DeleteAllGatesButton_Click" ToolTip="Remove every gate"/>
                    <Button x:Name="ImportGatesButton" Content="Import" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="ImportGatesButton_Click" ToolTip="Import gates from VBTS (.vbts)"/>
                    <Button x:Name="ExportGatesButton" Content="Export" Style="{StaticResource HeaderButtonStyle}"
                            Click="ExportGatesButton_Click" ToolTip="Export gates (.spl) — coming soon"/>
                </StackPanel>

                <StackPanel x:Name="Map3DToolbar" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,4,0" Visibility="Collapsed">
                    <TextBlock x:Name="Map3DSourceLabel" Text="Source" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="Map3DSourceCombo" Width="175" Height="26" Margin="0,0,8,0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="Map3DSourceCombo_SelectionChanged"/>
                    <TextBlock x:Name="AltitudeModeLabel" Text="Height" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="AltitudeModeCombo" Width="120" Height="26" Margin="0,0,8,0"
                              Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="AltitudeModeCombo_SelectionChanged">
                        <ComboBoxItem Tag="recorded" Content="Recorded" IsSelected="True"/>
                        <ComboBoxItem Tag="ground" Content="Ground"/>
                    </ComboBox>
                    <TextBlock x:Name="ExaggerationLabel" Text="Exaggeration" Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="ExaggerationCombo" Width="62" Height="26" Margin="0,0,8,0"
                              Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="ExaggerationCombo_SelectionChanged">
                        <ComboBoxItem Tag="1" Content="1×" IsSelected="True"/>
                        <ComboBoxItem Tag="2" Content="2×"/>
                        <ComboBoxItem Tag="5" Content="5×"/>
                        <ComboBoxItem Tag="10" Content="10×"/>
                    </ComboBox>
                    <Button x:Name="Fit3DButton" Content="Fit" Style="{StaticResource HeaderButtonStyle}"
                            Click="Fit3DButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 地图区 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource MapCanvasBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">

                <Grid x:Name="MapHost">

                    <Grid x:Name="Map2DHost">

                    <!-- 第 0 层：在线地图瓦片（轨迹 / Gate 之下） -->
                    <Canvas x:Name="TileCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <!-- 第 1 层：比例尺网格（在轨迹下方）
                         屏幕层覆盖物：平移时不动，缩放时间距跟着变。
                         Plot 背景透明，所以网格能透过显示。 -->
                    <Canvas x:Name="GridOverlay"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <!-- 第 2 层：轨迹（ScottPlot，背景透明以便网格在下方可见） -->
                    <Grid x:Name="PlotHost"/>

                    <!-- Gate color legend (UpperLeft; separate from ScottPlot UpperRight track legend) -->
                    <Border x:Name="GateLegendPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            Background="{DynamicResource OverlayScrim}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsHitTestVisible="False"
                            MaxWidth="200">
                        <StackPanel>
                            <TextBlock Text="Gates"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ItemsControl x:Name="GateLegendItems"/>
                        </StackPanel>
                    </Border>


                    <!-- 第 3 层：悬停速度提示 -->
                    <Border x:Name="HoverTip"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="{DynamicResource HudBackground}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock x:Name="HoverTipText"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontSize="11"
                                   FontFamily="Consolas"/>
                    </Border>

                    <!-- 无数据提示 -->
                    <StackPanel x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                        <TextBlock Text="Track Map"
                                   Foreground="{DynamicResource MapPlaceholderForeground}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Waiting for GPS data"
                                   Foreground="{DynamicResource MapHintForeground}"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- 右下角：当前坐标 -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,14"
                                IsHitTestVisible="False">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="Lat"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LatText"
                                       Text="--"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Lon"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LonText"
                                       Text="--"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Alt"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="AltText"
                                       Text="--"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                    </StackPanel>

                    </Grid>

                    <Grid x:Name="Map3DHost" Visibility="Collapsed">
                        <wv2:WebView2 x:Name="Map3DWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Border x:Name="Map3DStatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource HudBackground}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1" CornerRadius="4" Padding="14,10" IsHitTestVisible="False">
                            <TextBlock x:Name="Map3DStatusText" Text="Loading 3D map…"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                       MaxWidth="360" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>
