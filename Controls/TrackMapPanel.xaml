<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12171E">

    <Border BorderBrush="#1E2530"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="◎"
                           Foreground="#8A94A6"
                           FontSize="14"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Track Map"
                           Foreground="#E6EAF0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- 预留：测试选择下拉 -->
                <ComboBox Grid.Column="2"
                          Width="100"
                          Height="24"
                          VerticalContentAlignment="Center"
                          IsEnabled="False"
                          Margin="0,0,8,0">
                    <ComboBoxItem Content="Track 1"
                                  IsSelected="True"/>
                </ComboBox>

                <Button Grid.Column="3"
                        Content="⧉"
                        Style="{StaticResource HeaderButtonStyle}"
                        FontSize="13"
                        Padding="4,0"
                        IsEnabled="False"/>
            </Grid>

            <!-- 地图区 -->
            <Border Grid.Row="1"
                    Background="#0A0F15"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">

                <Grid x:Name="MapHost">

                    <!-- 第 1 层：轨迹（ScottPlot 自己画，坐标轴刻度全部隐藏） -->
                    <Grid x:Name="PlotHost"/>

                    <!-- 第 2 层：比例尺网格
                         刻意做成"屏幕层"覆盖物：
                         拖动时完全不动，只有缩放时间距跟着变。
                         它是用户拿来核对尺寸的参考底图，
                         不参与任何经纬度换算。 -->
                    <Canvas x:Name="GridOverlay"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <!-- 第 3 层：悬停速度提示 -->
                    <Border x:Name="HoverTip"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="#CC161D26"
                            BorderBrush="#C8A34A"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock x:Name="HoverTipText"
                                   Foreground="#E6EAF0"
                                   FontSize="11"
                                   FontFamily="Consolas"/>
                    </Border>

                    <!-- 无数据提示 -->
                    <StackPanel x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                        <TextBlock Text="Track Map"
                                   Foreground="#4A5568"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Waiting for GPS data"
                                   Foreground="#39424F"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- 右下角：当前坐标 -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,14"
                                IsHitTestVisible="False">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="Lat"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LatText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Lon"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LonText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Alt"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="AltText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>
