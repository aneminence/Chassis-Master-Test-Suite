<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12171E">

    <Border BorderBrush="#1E2530"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="◎"
                           Foreground="#8A94A6"
                           FontSize="14"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Track Map"
                           Foreground="#E6EAF0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <!-- 预留：测试选择下拉 -->
                <ComboBox Grid.Column="2"
                          Width="100"
                          Height="24"
                          VerticalContentAlignment="Center"
                          IsEnabled="False"
                          Margin="0,0,8,0">
                    <ComboBoxItem Content="Track 1"
                                  IsSelected="True"/>
                </ComboBox>

                <Button Grid.Column="3"
                        Content="⧉"
                        Style="{StaticResource HeaderButtonStyle}"
                        FontSize="13"
                        Padding="4,0"
                        IsEnabled="False"/>

            </Grid>

            <!-- 地图区（未开发） -->
            <Border Grid.Row="1"
                    Background="#0A0F15"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">

                <Grid>

                    <!-- 占位网格背景 -->
                    <Canvas ClipToBounds="True">

                        <!-- 纵向参考线 -->
                        <Line X1="120" Y1="0" X2="120" Y2="1200"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="240" Y1="0" X2="240" Y2="1200"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="360" Y1="0" X2="360" Y2="1200"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="480" Y1="0" X2="480" Y2="1200"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="600" Y1="0" X2="600" Y2="1200"
                              Stroke="#151C24" StrokeThickness="1"/>

                        <!-- 横向参考线 -->
                        <Line X1="0" Y1="100" X2="1200" Y2="100"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="0" Y1="200" X2="1200" Y2="200"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="0" Y1="300" X2="1200" Y2="300"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="0" Y1="400" X2="1200" Y2="400"
                              Stroke="#151C24" StrokeThickness="1"/>
                        <Line X1="0" Y1="500" X2="1200" Y2="500"
                              Stroke="#151C24" StrokeThickness="1"/>

                    </Canvas>

                    <!-- 占位提示 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="Track Map"
                                   Foreground="#4A5568"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Vehicle test trajectory"
                                   Foreground="#39424F"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Not implemented yet"
                                   Foreground="#C8A34A"
                                   FontSize="11"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- 右下角：比例尺 + 坐标（占位） -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,14">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="Lat"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Lon"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Alt"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>
