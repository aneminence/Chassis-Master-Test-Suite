<UserControl x:Class="Chassis_Master_Test_Suite.Controls.TrackMapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12171E">

    <Border BorderBrush="#1E2530"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="◎"
                           Foreground="#8A94A6"
                           FontSize="14"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Track Map"
                           Foreground="#E6EAF0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="AddGateButton" Content="Add Gate" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="AddGateButton_Click" ToolTip="Click track to place a new named gate"/>
                    <ComboBox x:Name="GateCombo" Width="130" Height="26" Margin="0,0,6,0"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="GateCombo_SelectionChanged"
                              ToolTip="Select gate"/>
                    <TextBlock Text="W" Foreground="#8A94A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="GateWidthBox" Width="44" Height="26" Margin="0,0,2,0"
                             Text="20" Style="{StaticResource DarkTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             ToolTip="Gate width (meters)"
                             LostFocus="GateWidthBox_LostFocus" KeyDown="GateWidthBox_KeyDown"/>
                    <TextBlock Text="m" Foreground="#5A6474" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="RenameGateButton" Content="Rename" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="RenameGateButton_Click" ToolTip="Rename selected gate"/>
                    <Button x:Name="DeleteGateButton" Content="Delete" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="DeleteGateButton_Click" ToolTip="Delete selected gate"/>
                    <Button x:Name="DeleteAllGatesButton" Content="Delete All" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="DeleteAllGatesButton_Click" ToolTip="Remove every gate"/>
                    <Button x:Name="ImportGatesButton" Content="Import" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0"
                            Click="ImportGatesButton_Click" ToolTip="Import gates from VBTS (.vbts)"/>
                    <Button x:Name="ExportGatesButton" Content="Export" Style="{StaticResource HeaderButtonStyle}"
                            Click="ExportGatesButton_Click" ToolTip="Export gates (.spl) — coming soon"/>
                </StackPanel>
            </Grid>

            <!-- 地图区 -->
            <Border Grid.Row="1"
                    Background="#0A0F15"
                    BorderBrush="#1E2530"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">

                <Grid x:Name="MapHost">

                    <!-- 第 1 层：比例尺网格（在轨迹下方）
                         屏幕层覆盖物：平移时不动，缩放时间距跟着变。
                         Plot 背景透明，所以网格能透过显示。 -->
                    <Canvas x:Name="GridOverlay"
                            IsHitTestVisible="False"
                            ClipToBounds="True"/>

                    <!-- 第 2 层：轨迹（ScottPlot，背景透明以便网格在下方可见） -->
                    <Grid x:Name="PlotHost"/>

                    <!-- Gate color legend (UpperLeft; separate from ScottPlot UpperRight track legend) -->
                    <Border x:Name="GateLegendPanel"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            Background="#E612171E"
                            BorderBrush="#1E2530"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            IsHitTestVisible="False"
                            MaxWidth="200">
                        <StackPanel>
                            <TextBlock Text="Gates"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ItemsControl x:Name="GateLegendItems"/>
                        </StackPanel>
                    </Border>


                    <!-- 第 3 层：悬停速度提示 -->
                    <Border x:Name="HoverTip"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="#CC161D26"
                            BorderBrush="#C8A34A"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <TextBlock x:Name="HoverTipText"
                                   Foreground="#E6EAF0"
                                   FontSize="11"
                                   FontFamily="Consolas"/>
                    </Border>

                    <!-- 无数据提示 -->
                    <StackPanel x:Name="EmptyHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                        <TextBlock Text="Track Map"
                                   Foreground="#4A5568"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Waiting for GPS data"
                                   Foreground="#39424F"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- 右下角：当前坐标 -->
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,14"
                                IsHitTestVisible="False">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <TextBlock Text="Lat"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LatText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Lon"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="LonText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,3,0,0">

                            <TextBlock Text="Alt"
                                       Foreground="#5A6474"
                                       FontSize="10"
                                       Margin="0,0,6,0"/>

                            <TextBlock x:Name="AltText"
                                       Text="--"
                                       Foreground="#8A94A6"
                                       FontSize="10"
                                       FontFamily="Consolas"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>
